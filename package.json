    "cross-fetch": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-native": "^4.1.0",
    "https-proxy-agent": "^7.0.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.0",
