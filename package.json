  "private": true,
  "scripts": {
    "android": "react-native run-android --mode arm64Debug --appId com.cookingguidern.arm64",
    "ios": "react-native run-ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "node scripts/clean-ios-deps.js && node scripts/download-audio-libs.js && patch-package",
