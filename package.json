    "@react-navigation/native-stack": "^6.x",
    "@xstate/react": "^6.1.0",
    "i18next": "^26.4.1",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.0",
    "react-native-audio-api": "^0.12.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
